{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/react/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/prompt.txt",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
